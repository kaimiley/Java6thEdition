{
  "manifest_version": 3,
  "name": "CR Hotel Itemizer Assistant",
  "version": "1.0.0",
  "description": "Parses hotel folio PDFs and assists day-by-day itemizations in Chrome River expense pages.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.chromeriver.com/*",
    "https://*.chromeriver.net/*",
    "https://*.emburse.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_title": "CR Hotel Itemizer",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://*.chromeriver.com/*",
        "https://*.chromeriver.net/*",
        "https://*.emburse.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/pdf.min.js",
        "vendor/pdf.worker.min.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
